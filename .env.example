# Knowra Environment Variables Configuration Template
# Copy this file to .env and replace placeholders with your actual configuration.
# DO NOT commit .env to version control.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Database (PostgreSQL)
# For local Docker setup (default docker-compose):
DATABASE_URL="postgresql://knowra_admin:knowra_secret@localhost:5432/knowra_db?schema=public"
# For Supabase / Neon / Cloud PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Authentication (Auth.js / NextAuth)
# Generate a secret: npx auth secret or openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-secret"
AUTH_URL="http://localhost:3000"

# AI Provider Configuration (Optional - Knowra runs 100% without AI credentials)
# Available providers: mock | gemini | openai | groq
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Public API Settings
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
